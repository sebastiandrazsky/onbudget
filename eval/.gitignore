# full raw run directories stay on disk; only the light per-run files are committed (see README.md)
runs/*/ws/
runs/*/transcript/
runs/*/transcript.part/
tmp/
*.nohup
*.tmp
queue.lock
queue.lock.*
PAUSED.json
__pycache__/
# the second round (eval/r2): the same rules
r2/runs/*/ws/
r2/runs/*/transcript/
r2/runs/*/transcript.part/
r2/tmp/
r2/*.nohup
r2/queue.lock
r2/queue.lock.*
r2/PAUSED.json
