+
+    return handler
+
+
+def test_no_reporter(asgi, util):
+    app = util.create_app(asgi)
+    app.add_route('/items/{name}', _make_resources(asgi))
+    client = testing.TestClient(app)
+
+    assert client.simulate_get('/items/foo').status_code == 500
+    assert client.simulate_get('/nope').status_code == 404
+
+
+def test_route_not_found(client, reports):
+    assert client.simulate_get('/nope').status_code == 404
+
+    ((path, ex, params, handled),) = reports
+    assert path == '/nope'
+    assert isinstance(ex, falcon.HTTPRouteNotFound)
+    assert params == {}
+    assert handled is True
+
+
+def test_responder_errors(client, reports):
+    assert client.simulate_get('/items/foo').status_code == 500
+    assert client.simulate_post('/items/bar').status_code == 403
+
+    assert reports.summary == [(ZeroDivisionError, True), (falcon.HTTPForbidden, True)]
+    assert reports[0][2] == {'name': 'foo'}
+    assert reports[1][2] == {'name': 'bar'}
+
+
