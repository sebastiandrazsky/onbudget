+import pytest
+
+import falcon
+import falcon.asgi
+from falcon import testing
+
+
+class Reports(list):
+    def __call__(self, req, ex, params, handled):
+        self.append((req.path, ex, dict(params), handled))
+
+    @property
+    def summary(self):
+        return [(type(ex), handled) for _, ex, _, handled in self]
+
+
+def _make_resources(asgi):
+    if asgi:
+
+        class Resource:
+            async def on_get(self, req, resp, name):
+                raise ZeroDivisionError('boom')
+
+            async def on_post(self, req, resp, name):
+                raise falcon.HTTPForbidden()
+
+            async def on_put(self, req, resp, name):
+                resp.status = 'not a status'
+
+            async def on_delete(self, req, resp, name):
+                resp.media = object()
+
+    else:
+
+        class Resource:
+            def on_get(self, req, resp, name):
+                raise ZeroDivisionError('boom')
+
+            def on_post(self, req, resp, name):
+                raise falcon.HTTPForbidden()
+
+            def on_put(self, req, resp, name):
+                resp.status = 'not a status'
+
+            def on_delete(self, req, resp, name):
+                resp.media = object()
+
+    return Resource()
+
+
+@pytest.fixture
+def reports():
+    return Reports()
+
+
+@pytest.fixture
+def client(asgi, util, reports):
+    app = util.create_app(asgi)
+    app.add_route('/items/{name}', _make_resources(asgi))
+    app.set_error_reporter(reports)
+    return testing.TestClient(app)
+
+
+def _handler(asgi, func):
+    if not asgi:
+        return func
+
+    async def handler(req, resp, ex, params):
