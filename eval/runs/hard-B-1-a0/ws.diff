+def _is_collection_type(type_: Any, kinds: tuple[type, ...] = (Sequence, AbstractSet, Mapping)) -> bool:
+    """Check if a type (bare or parameterized) is a subclass of one of the collection ABCs in `kinds`.
+
+    `str`, `bytes` and `bytearray` are sequences too, but are never considered collections.
+    """
+    origin = get_origin(type_) or type_
+    try:
+        return (
+            isinstance(origin, type) and not issubclass(origin, (str, bytes, bytearray)) and issubclass(origin, kinds)
+        )
+    except TypeError:
+        return False
+
+
+def _annotation_contains_collection(
+    annotation: Any, kinds: tuple[type, ...] = (Sequence, AbstractSet, Mapping)
+) -> bool:
+    """Check if a type annotation is, or contains, a collection type (see `_is_collection_type`)."""
+    annotation = _strip_annotated(annotation)
+    if _is_collection_type(annotation, kinds):
+        return True
+    return any(_annotation_contains_collection(type_, kinds) for type_ in get_args(annotation))
 
 
