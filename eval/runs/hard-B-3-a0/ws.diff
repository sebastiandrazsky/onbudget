--- a/falcon/tests/test_error_reporter.py
+++ b/falcon/tests/test_error_reporter.py
@@ -0,0 +1,84 @@
+import pytest
+
+import falcon
+import falcon.asgi
+import falcon.testing as testing
+
+
+def _make(asgi):
+    app = falcon.asgi.App() if asgi else falcon.App()
+    reports = []
+
+    def reporter(req, ex, params, handled):
+        reports.append((type(ex), handled))
+
+    app.set_error_reporter(reporter)
+
+    if asgi:
+
+        class Resource:
+            async def on_get(self, req, resp):
+                raise ZeroDivisionError
+
+            async def on_put(self, req, resp):
+                raise KeyError
+
+            async def on_post(self, req, resp):
+                resp.status = 'bogus'
+
+        async def to_status(req, resp, ex, params):
+            raise falcon.HTTPStatus(falcon.HTTP_200)
+
+        async def to_error(req, resp, ex, params):
+            raise ValueError
+
+    else:
+
+        class Resource:
+            def on_get(self, req, resp):
+                raise ZeroDivisionError
+
+            def on_put(self, req, resp):
+                raise KeyError
+
+            def on_post(self, req, resp):
+                resp.status = 'bogus'
+
+        def to_status(req, resp, ex, params):
+            raise falcon.HTTPStatus(falcon.HTTP_200)
+
+        def to_error(req, resp, ex, params):
+            raise ValueError
+
+    app.add_error_handler(ZeroDivisionError, to_status)
+    app.add_error_handler(KeyError, to_error)
+    app.add_route('/resource', Resource())
+    return testing.TestClient(app), reports
+
+
+@pytest.mark.parametrize('asgi', [False, True])
+def test_reports(asgi):
+    client, reports = _make(asgi)
+
+    assert client.simulate_get('/unknown').status_code == 404
+    assert reports == [(falcon.HTTPRouteNotFound, True)]
+    del reports[:]
+
+    assert client.simulate_get('/resource').status_code == 200
+    assert reports == [(ZeroDivisionError, True), (falcon.HTTPStatus, True)]
+    del reports[:]
+
+    with pytest.raises(ValueError):
+        client.simulate_put('/resource')
+    assert reports == [(KeyError, True), (ValueError, False)]
+    del reports[:]
+
+    with pytest.raises(ValueError):
+        client.simulate_post('/resource')
+    assert reports == [(ValueError, False)]
+
+
+@pytest.mark.parametrize('asgi', [False, True])
+def test_no_reporter(asgi):
+    app = falcon.asgi.App() if asgi else falcon.App()
+    assert testing.TestClient(app).simulate_get('/unknown').status_code == 404
