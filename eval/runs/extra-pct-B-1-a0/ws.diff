+from __future__ import annotations
+
+import pytest
+
+from werkzeug import http
+from werkzeug.datastructures import ETag
+from werkzeug.datastructures import ETagSet
+from werkzeug.wrappers import Response
+
+
+def test_etag_class() -> None:
+    etag = ETag("x")
+    assert etag.value == "x"
+    assert not etag.weak
+    assert etag.to_header() == str(etag) == '"x"'
+    assert repr(etag) == "<ETag 'x' strong>"
+    assert ETag("x", True).to_header() == 'W/"x"'
+    assert repr(ETag("x", True)) == "<ETag 'x' weak>"
+    assert etag == ETag("x")
+    assert etag != ETag("x", True)
+    assert etag != ETag("y")
+    assert etag
+    assert not ETag("")
+    assert ETag("").to_header() == ""
+    assert ETag('a"b').to_header() == ""
+
+
+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [
+        ('"x"', ETag("x")),
+        ('W/"x"', ETag("x", True)),
+        ('w/"x"', ETag("x", True)),
+        ("", None),
+        (None, None),
+        ("x", None),
+        ('"', None),
+        ("W/x", None),
+    ],
+)
+def test_etag_from_header(value: str | None, expect: ETag | None) -> None:
+    assert ETag.from_header(value) == expect
+
+
+def test_etags_renamed() -> None:
+    import werkzeug.datastructures as ds
+
+    with pytest.deprecated_call(match="renamed to 'ETagSet'.*Werkzeug 3.3"):
+        assert ds.ETags is ETagSet
+
+
+def test_response_etag() -> None:
+    response = Response()
+    assert response.etag is None
+    response.etag = "a"
+    assert response.headers["ETag"] == '"a"'
+    assert response.etag == ETag("a")
+    response.etag = ("b", True)
+    assert response.headers["ETag"] == 'W/"b"'
+    response.etag = ETag("c")
+    etag = response.etag
+    assert etag is not None
+    etag.weak = True
+    assert response.headers["ETag"] == 'W/"c"'
+    etag.value = "d"
+    assert response.headers["ETag"] == 'W/"d"'
+    response.etag = None
+    assert "ETag" not in response.headers
+    response.etag = "a"
+    del response.etag
+    assert "ETag" not in response.headers
+    response.headers["ETag"] = "invalid"
+    assert response.etag is None
+
+
+def test_deprecated_etag_api() -> None:
+    response = Response()
+
+    with pytest.deprecated_call(match="'etag' attribute"):
+        response.set_etag("a", weak=True)
+
+    with pytest.deprecated_call(match="'etag' attribute"):
+        assert response.get_etag() == ("a", True)
+
+    del response.etag
+
+    with pytest.deprecated_call(match="'etag' attribute"):
+        assert response.get_etag() == (None, None)
+
+    with pytest.deprecated_call(match="ETag.to_header"):
+        assert http.quote_etag("a") == '"a"'
+
+    with pytest.deprecated_call(match="ETag.from_header"):
+        assert http.unquote_etag('W/"a"') == ("a", True)
