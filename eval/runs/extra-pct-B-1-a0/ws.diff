+import io
+
+import falcon
+import falcon.asgi
+import falcon.testing as testing
+
+
+def make(app_cls, is_async):
+    reports = []
+    app = app_cls()
+    app.set_error_reporter(lambda req, ex, params, handled: reports.append((type(ex).__name__, handled)))
+
+    def sync_or_async(fn):
+        if not is_async:
+            return fn
+
+        async def wrapper(*a, **kw):
+            return fn(*a, **kw)
+
+        return wrapper
+
+    class Res:
+        def get(self, req, resp, kind):
+            if kind == 'zero':
+                1 / 0
+            if kind == 'status':
+                resp.status = 'bogus'
+            if kind == 'header':
+                resp.set_header('X-Y', 'café€')
+            if kind == 'custom':
+                raise KeyError('x')
+            if kind == 'same':
+                raise ValueError('x')
+            if kind == 'other':
+                raise LookupError('x')
+            if kind == 'ser':
+                raise falcon.HTTPBadRequest()
+
+    res = Res()
+    if is_async:
+
+        async def on_get(req, resp, kind):
+            res.get(req, resp, kind)
+
+        res.on_get = on_get
+    else:
+        res.on_get = res.get
+
+    def h_custom(req, resp, ex, params, **kw):
+        raise falcon.HTTPStatus(falcon.HTTP_204)
+
+    def h_same(req, resp, ex, params, **kw):
+        raise ex
+
+    def h_other(req, resp, ex, params, **kw):
+        raise RuntimeError('boom')
+
+    app.add_error_handler(KeyError, sync_or_async(h_custom))
+    app.add_error_handler(ValueError, sync_or_async(h_same))
+    app.add_error_handler(LookupError, sync_or_async(h_other))
+    app.add_route('/r/{kind}', res)
+    return app, reports
+
+
+for cls, is_async in ((falcon.App, False), (falcon.asgi.App, True)):
+    print(cls)
+    for kind in ('ok', 'zero', 'status', 'header', 'custom', 'same', 'other', 'ser'):
+        app, reports = make(cls, is_async)
+        if kind == 'ser':
+
+            def bad(req, resp, ex):
+                raise TypeError('ser')
+
+            app.set_error_serializer(bad)
+        client = testing.TestClient(app)
+        stderr = io.StringIO()
+        try:
+            r = client.simulate_get('/r/' + kind, wsgierrors=stderr)
+            out = r.status
+        except Exception as e:
+            out = 'RAISED ' + type(e).__name__
+        print(' ', kind, out, reports, repr(stderr.getvalue()[:40]))
+    app, reports = make(cls, is_async)
+    print('  404', testing.TestClient(app).simulate_get('/nope').status, reports)
