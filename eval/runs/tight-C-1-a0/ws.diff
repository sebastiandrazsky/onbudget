+def _provided_kwargs(
+    hook_impl: HookImpl, caller_kwargs: Mapping[str, object]
+) -> Sequence[object]:
+    """Return the values for the defaulted hookimpl arguments, as trailing
+    positional arguments. Provided values win over the hookimpl defaults."""
+    kwargnames = hook_impl.kwargnames
+    defaults = getattr(hook_impl.function, "__defaults__", None) or ()
+    if len(defaults) < len(kwargnames):
+        defaults = ()
+    else:
+        defaults = defaults[len(defaults) - len(kwargnames) :]
+    values = []
+    for i, argname in enumerate(kwargnames):
+        if argname in caller_kwargs:
+            values.append(caller_kwargs[argname])
+        elif defaults and any(n in caller_kwargs for n in kwargnames[i + 1 :]):
+            values.append(defaults[i])
+        else:
+            break
+    return values
