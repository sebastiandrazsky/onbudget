+    """Check if a type annotation is, or contains, a subclass of any of the specified base types.
+
+    `str`, `bytes` and `bytearray` are never matched, even though they are sequences.
+    """
+    annotation = _strip_annotated(annotation)
+    if _is_subclass_type(annotation, bases):
