@@ -0,0 +1,176 @@
+import pytest
+
+import falcon
+import falcon.asgi
+import falcon.testing as testing
+
+
+class Resource:
+    def on_get(self, req, resp, kind):
+        if kind == 'zero':
+            raise ZeroDivisionError('zero')
+        if kind == 'status':
+            resp.status = 'not a status'
+        if kind == 'header':
+            resp.set_header('X-Thing', 'ሴ')
+        resp.media = kind
+
+
+class ResourceAsync:
+    async def on_get(self, req, resp, kind):
+        Resource.on_get(self, req, resp, kind)
+
+    async def on_websocket(self, req, ws, kind):
+        await ws.accept()
+        raise ZeroDivisionError('ws')
+
+
+@pytest.fixture(params=[False, True], ids=['wsgi', 'asgi'])
+def setup(request):
+    reports = []
+
+    def reporter(req, ex, params, handled):
+        reports.append((type(ex), dict(params), handled))
+
+    if request.param:
+        app = falcon.asgi.App()
+        app.add_route('/{kind}', ResourceAsync())
+    else:
+        app = falcon.App()
+        app.add_route('/{kind}', Resource())
+
+    app.set_error_reporter(lambda *args: pytest.fail('should be replaced'))
+    app.set_error_reporter(reporter)
+    return app, testing.TestClient(app), reports, request.param
+
+
+def _add_handler(app, asgi, exception, func):
+    if asgi:
+
+        async def handler(req, resp, ex, params):
+            func(ex)
+
+    else:
+
+        def handler(req, resp, ex, params):
+            func(ex)
+
+    app.add_error_handler(exception, handler)
+
+
+def _raise(ex):
+    raise ex
+
+
+def test_no_error(setup):
+    app, client, reports, asgi = setup
+    assert client.simulate_get('/ok').status_code == 200
+    assert reports == []
+
+
+def test_route_not_found(setup):
+    app, client, reports, asgi = setup
+    assert client.simulate_get('/no/such').status_code == 404
+    assert reports == [(falcon.HTTPRouteNotFound, {}, True)]
+
+
+def test_default_handler(setup):
+    app, client, reports, asgi = setup
+    assert client.simulate_get('/zero').status_code == 500
+    assert reports == [(ZeroDivisionError, {'kind': 'zero'}, True)]
+
+
+def test_unhandled(setup):
+    app, client, reports, asgi = setup
+    app._error_handlers.pop(Exception)
+    with pytest.raises(ZeroDivisionError):
+        client.simulate_get('/zero')
+    assert reports == [(ZeroDivisionError, {'kind': 'zero'}, False)]
+
+
+def test_handler_reraises_same(setup):
+    app, client, reports, asgi = setup
+    _add_handler(app, asgi, ZeroDivisionError, _raise)
+    with pytest.raises(ZeroDivisionError):
+        client.simulate_get('/zero')
+    assert reports == [(ZeroDivisionError, {'kind': 'zero'}, True)]
+
+
+def test_handler_reraises_same_http_error(setup):
+    app, client, reports, asgi = setup
+    _add_handler(app, asgi, falcon.HTTPNotFound, _raise)
+    assert client.simulate_get('/no/such').status_code == 404
+    assert reports == [(falcon.HTTPRouteNotFound, {}, True)]
+
+
+@pytest.mark.parametrize(
+    'raised, status',
+    [(falcon.HTTPStatus(falcon.HTTP_204), 204), (falcon.HTTPGone(), 410)],
+)
+def test_handler_raises_http(setup, raised, status):
+    app, client, reports, asgi = setup
+    _add_handler(app, asgi, ZeroDivisionError, lambda ex: _raise(raised))
+    assert client.simulate_get('/zero').status_code == status
+    assert reports == [
+        (ZeroDivisionError, {'kind': 'zero'}, True),
+        (type(raised), {'kind': 'zero'}, True),
+    ]
+
+
+def test_handler_raises_other(setup):
+    app, client, reports, asgi = setup
+    _add_handler(app, asgi, ZeroDivisionError, lambda ex: _raise(KeyError('other')))
+    with pytest.raises(KeyError):
+        client.simulate_get('/zero')
+    assert reports == [
+        (ZeroDivisionError, {'kind': 'zero'}, True),
+        (KeyError, {'kind': 'zero'}, False),
+    ]
+
+
+@pytest.mark.parametrize('via_handler', [False, True])
+def test_serializer_raises(setup, via_handler):
+    app, client, reports, asgi = setup
+    app.set_error_serializer(lambda req, resp, ex: _raise(KeyError('ser')))
+    expected = [(falcon.HTTPRouteNotFound, {}, True)]
+    if via_handler:
+        _add_handler(
+            app, asgi, falcon.HTTPNotFound, lambda ex: _raise(falcon.HTTPGone())
+        )
+        expected.append((falcon.HTTPGone, {}, True))
+    expected.append((KeyError, {}, False))
+
+    with pytest.raises(KeyError):
+        client.simulate_get('/no/such')
+    assert reports == expected
+
+
+def test_response_cannot_be_started(setup):
+    app, client, reports, asgi = setup
+    with pytest.raises(Exception) as excinfo:
+        client.simulate_get('/header' if asgi else '/status')
+    assert reports == [(excinfo.type, {'kind': 'header' if asgi else 'status'}, False)]
+
+
+def test_response_cannot_be_started_no_reporter(setup):
+    app, client, reports, asgi = setup
+    app.set_error_reporter(None)
+    with pytest.raises(Exception):
+        client.simulate_get('/header' if asgi else '/status')
+    assert reports == []
+
+
+async def test_websocket():
+    reports = []
+    app = falcon.asgi.App()
+    app.add_route('/{kind}', ResourceAsync())
+    app.set_error_reporter(
+        lambda req, ex, params, handled: reports.append((type(ex), params, handled))
+    )
+
+    async with testing.ASGIConductor(app) as conductor:
+        with pytest.raises(falcon.WebSocketDisconnected):
+            async with conductor.simulate_ws('/ws') as ws:
+                await ws.receive_text()
+
+    assert reports == [(ZeroDivisionError, {'kind': 'ws'}, True)]
