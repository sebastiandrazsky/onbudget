+import sys
+from collections import OrderedDict, deque
+from collections.abc import MutableMapping, MutableSequence
+from typing import Optional, Tuple
+from pydantic_settings import BaseSettings, CliApp, CliVariadicArg, CliPositionalArg, SettingsError
+def run(ann, args, **kw):
+    class S(BaseSettings):
+        val: ann
+    try: r = CliApp.run(S, cli_args=args, cli_exit_on_error=False, **kw).val; print(str(ann)[-40:], args, '->', repr(r))
+    except BaseException as e: print(ann, args, 'ERR', type(e).__name__, str(e)[-90:])
+run(CliVariadicArg[tuple[str, ...]], ['--val','a','b'])
+run(CliVariadicArg[frozenset[str]], ['--val','x','y'])
+run(CliVariadicArg[OrderedDict[str,str]], ['--val','a=1','b=2'])
+run(CliPositionalArg[CliVariadicArg[tuple[str, ...]]], ['a','b'])
+run(tuple[str, ...], ['--val','a','--val','b'])
+run(tuple, ['--val','a','--val','b'])
+run(frozenset, ['--val','a'])
+run(Tuple, ['--val','a'])
+run(deque[int], ['--val','1','--val','2'])
+run(MutableSequence[int], ['--val','1,2'])
+run(Optional[tuple[str, ...]], ['--val','a','--val','b'])
+run(Optional[OrderedDict[str,str]], ['--val','a=1','--val','b=2'])
+run(MutableMapping[str,str], ['--val','a=1'])
+run(str, ['--val','a','b'])
+run(bytes, ['--val','a'])
+run(CliVariadicArg[Optional[frozenset[str]]], ['--val','a'])
