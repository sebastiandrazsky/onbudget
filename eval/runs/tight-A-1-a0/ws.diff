+    annotation: type[Any] | None, types: tuple[type[Any], ...] = (Sequence, AbstractSet, Mapping)
+) -> bool:
+    """Check if a type annotation contains a subclass of any of the specified collection types."""
+    annotation = _strip_annotated(annotation)
+    if _is_collection_type(annotation, types) or _is_collection_type(get_origin(annotation), types):
+        return True
+    return any(_annotation_contains_collection(type_, types) for type_ in get_args(annotation))
