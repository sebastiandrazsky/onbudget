+def _is_collection_type(type_: Any, types: tuple[type[Any], ...] = (Sequence, AbstractSet, Mapping)) -> bool:
+    """Check if a type is a subclass of any of the specified collection types.
+
+    `str`, `bytes` and `bytearray` are sequences, but hold a single value and are never collections.
+    """
+    try:
+        return (
+            isinstance(type_, type) and issubclass(type_, types) and not issubclass(type_, (str, bytes, bytearray))
+        )
+    except TypeError:
+        # Some types, e.g. `TypedDict`, do not support class checks.
+        return False
