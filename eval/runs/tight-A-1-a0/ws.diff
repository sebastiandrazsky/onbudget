+        assert r == type(exp)(['a'])
+
+
+MAPS = [
+    (OrderedDict[str, str], OrderedDict), (MutableMapping[str, str], dict), (OrderedDict, OrderedDict),
+    (MutableMapping, dict), (Optional[OrderedDict[str, str]], OrderedDict),
+    (MutableMapping[str, str] | None, dict), (typing.OrderedDict[str, str], OrderedDict),
+]
+
+
