+    tuple[str, ...], frozenset[str], typing.Tuple[str, ...], MutableSequence[str], MutableMapping[str, str],
+    deque[str], OrderedDict[str, str], typing.Deque[str], typing.OrderedDict[str, str], typing.FrozenSet[str],
+    list, set, dict, list[int], typing.Sequence[int], typing.Mapping[str, int],
+]
+
+
+@pytest.mark.parametrize('t', COLLS)
+def test_detect(t):
+    assert _annotation_contains_collection(t)
+    assert _annotation_contains_collection(t | None if not isinstance(t, typing._GenericAlias) else Optional[t])
+    assert _annotation_contains_collection(Optional[t])
+    assert _annotation_contains_collection(typing.Annotated[t, 'x'])
+
+
+@pytest.mark.parametrize('t', [str, bytes, bytearray, int, Optional[str], str | None, bytes | None, typing.Literal['a']])
+def test_not_detect(t):
+    assert not _annotation_contains_collection(t)
+
+
+SEQ = [
+    (tuple[str, ...], ('a', 'b')), (tuple, ('a', 'b')), (typing.Tuple[str, ...], ('a', 'b')),
+    (typing.Tuple, ('a', 'b')), (frozenset[str], frozenset({'a', 'b'})), (frozenset, frozenset({'a', 'b'})),
+    (MutableSequence[str], ['a', 'b']), (deque[str], deque(['a', 'b'])), (deque, deque(['a', 'b'])),
+    (Optional[tuple[str, ...]], ('a', 'b')), (frozenset[str] | None, frozenset({'a', 'b'})),
+    (tuple[str, str], ('a', 'b')),
+]
+
+
+@pytest.mark.parametrize('t,exp', SEQ)
+def test_seq(t, exp):
+    class V(BaseSettings):
+        values: CliVariadicArg[t]
+
+    r = CliApp.run(V, cli_args=['--values', 'a', 'b']).values
+    assert r == exp and type(r) is type(exp)
+
+    class P(BaseSettings):
+        values: CliPositionalArg[CliVariadicArg[t]]
+
+    r = CliApp.run(P, cli_args=['a', 'b']).values
+    assert r == exp and type(r) is type(exp)
+
+    class P2(BaseSettings):
+        values: CliPositionalArg[t]
+
+    r = CliApp.run(P2, cli_args=['a', 'b']).values
+    assert r == exp and type(r) is type(exp)
+
+    class N(BaseSettings):
+        values: t
+
+    r = CliApp.run(N, cli_args=['--values', 'a', '--values', 'b']).values
+    assert r == exp and type(r) is type(exp)
+    r = CliApp.run(N, cli_args=['--values', 'a,b']).values
+    assert r == exp
+    r = CliApp.run(N, cli_args=['--values', '["a","b"]']).values
+    assert r == exp
+    if t is not tuple[str, str]:
