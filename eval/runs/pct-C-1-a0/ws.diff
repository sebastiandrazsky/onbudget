--- a/falcon/tests/test_error_reporter.py
+++ b/falcon/tests/test_error_reporter.py
@@ -0,0 +1,196 @@
+import pytest
+
+import falcon
+import falcon.asgi
+from falcon import testing
+
+
+class Resource:
+    def on_get(self, req, resp, kind):
+        if kind == 'zero':
+            raise ZeroDivisionError('zero')
+        if kind == 'key':
+            raise KeyError('key')
+        if kind == 'status':
+            resp.status = 'nope'
+        if kind == 'header':
+            resp.set_header('X-Thing', 'ሴ')
+        if kind == 'http':
+            raise falcon.HTTPGone()
+
+
+class ResourceAsync:
+    async def on_get(self, req, resp, kind):
+        Resource().on_get(req, resp, kind)
+
+    async def on_websocket(self, req, ws, kind):
+        raise ZeroDivisionError('ws')
+
+
+def _to_status(req, resp, ex, params):
+    raise falcon.HTTPStatus(falcon.HTTP_202)
+
+
+def _reraise(req, resp, ex, params):
+    raise ex
+
+
+def _broken(req, resp, ex, params):
+    raise ValueError('broken')
+
+
+async def _to_status_async(req, resp, ex, params):
+    _to_status(req, resp, ex, params)
+
+
+async def _reraise_async(req, resp, ex, params):
+    raise ex
+
+
+async def _broken_async(req, resp, ex, params):
+    raise ValueError('broken')
+
+
+@pytest.fixture(params=[False, True], ids=['wsgi', 'asgi'])
+def setup(request):
+    asgi = request.param
+    app = falcon.asgi.App() if asgi else falcon.App()
+    app.add_route('/{kind}', ResourceAsync() if asgi else Resource())
+    reports = []
+
+    def reporter(req, ex, params, handled):
+        reports.append((type(ex), dict(params), handled))
+
+    app.set_error_reporter(lambda *args: 1 / 0)
+    app.set_error_reporter(reporter)
+    handlers = (
+        (_to_status_async, _reraise_async, _broken_async)
+        if asgi
+        else (_to_status, _reraise, _broken)
+    )
+    return testing.TestClient(app), reports, handlers, asgi
+
+
+def test_no_reporter(util):
+    for asgi in (False, True):
+        app = util.create_app(asgi)
+        assert testing.simulate_get(app, '/nope').status_code == 404
+
+
+def test_handled(setup):
+    client, reports, handlers, asgi = setup
+    assert client.simulate_get('/a/b').status_code == 404
+    assert client.simulate_get('/http').status_code == 410
+    assert client.simulate_get('/zero').status_code == 500
+    assert reports == [
+        (falcon.HTTPRouteNotFound, {}, True),
+        (falcon.HTTPGone, {'kind': 'http'}, True),
+        (ZeroDivisionError, {'kind': 'zero'}, True),
+    ]
+
+
+def test_handler_raises(setup):
+    client, reports, handlers, asgi = setup
+    client.app.add_error_handler(ZeroDivisionError, handlers[0])
+    client.app.add_error_handler(falcon.HTTPGone, handlers[1])
+    client.app.add_error_handler(KeyError, handlers[2])
+
+    assert client.simulate_get('/zero').status_code == 202
+    assert client.simulate_get('/http').status_code == 410
+    with pytest.raises(ValueError):
+        client.simulate_get('/key')
+    assert reports == [
+        (ZeroDivisionError, {'kind': 'zero'}, True),
+        (falcon.HTTPStatus, {'kind': 'zero'}, True),
+        (falcon.HTTPGone, {'kind': 'http'}, True),
+        (KeyError, {'kind': 'key'}, True),
+        (ValueError, {'kind': 'key'}, False),
+    ]
+
+
+def test_handler_reraises_unhandled(setup):
+    client, reports, handlers, asgi = setup
+    client.app.add_error_handler(KeyError, handlers[1])
+    with pytest.raises(KeyError):
+        client.simulate_get('/key')
+    assert reports == [(KeyError, {'kind': 'key'}, True)]
+
+
+def test_no_handler(setup):
+    client, reports, handlers, asgi = setup
+    client.app._error_handlers.pop(Exception)
+    with pytest.raises(ZeroDivisionError):
+        client.simulate_get('/zero')
+    assert reports == [(ZeroDivisionError, {'kind': 'zero'}, False)]
+
+
+def test_serializer_raises(setup):
+    client, reports, handlers, asgi = setup
+
+    def serializer(req, resp, ex):
+        raise TypeError('serializer')
+
+    client.app.set_error_serializer(serializer)
+    client.app.add_error_handler(ZeroDivisionError, handlers[1])
+    client.app.add_error_handler(KeyError, handlers[0])
+    with pytest.raises(TypeError):
+        client.simulate_get('/http')
+    assert client.simulate_get('/key').status_code == 202
+    assert reports == [
+        (falcon.HTTPGone, {'kind': 'http'}, True),
+        (TypeError, {'kind': 'http'}, False),
