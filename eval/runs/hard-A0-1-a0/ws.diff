+    def set_error_reporter(self, reporter: ErrorReporter[_ReqT] | None) -> None:
+        """Set a callable to be notified of every exception raised in the app.
+
+        The error reporter affords observing all exceptions that are raised
+        while the framework is processing a request, regardless of whether
+        (and how) they are handled afterwards. This is useful for logging
+        errors, or for forwarding them to an error tracking service.
+
+        The reporter is called for every exception that is passed to the app's
+        error handling, including instances of :class:`~.HTTPError` and
+        :class:`~.HTTPStatus` (for example, a request to an unknown route is
+        reported as :class:`~.HTTPRouteNotFound`), whether the exception was
+        raised while routing the request, in a middleware component, hook or
+        responder, or while rendering the response body. The reporter is
+        invoked *before* the matching error handler (if any).
+
+        In addition, the following exceptions are reported:
+
+        * An instance of :class:`~.HTTPError` or :class:`~.HTTPStatus` raised
+          by an error handler is reported as handled, as the response is
+          rendered from it.
+        * Any other exception raised by an error handler, or by the error
+          serializer, is reported as unhandled, and propagated to the
+          application server.
+        * An exception that prevents the response from being started (such as
+          an invalid ``resp.status``) is reported as unhandled, and propagated
+          to the application server.
+
+        The same exception object is never reported twice in a row, so
+        an error handler may safely re-raise the exception it was passed.
+
+        Only one error reporter can be set per app; calling this method again
+        replaces the previously set reporter.
+
+        Note:
+            The reporter is only meant to observe exceptions. It is called
+            synchronously in the request processing path, so it should return
+            quickly. Any exception raised by the reporter itself is propagated
+            to the application server as-is.
+
+        For example::
+
+            def report_error(req, ex, params, handled):
+                if not isinstance(ex, (falcon.HTTPError, falcon.HTTPStatus)):
+                    logging.error(
+                        'Error serving %s %s', req.method, req.path, exc_info=ex
+                    )
+
+            app = falcon.App()
+            app.set_error_reporter(report_error)
