+        resp: _RespT,
+        ex: Exception,
+        params: dict[str, Any],
+        err_handler: ErrorHandler[_ReqT, _RespT] | None,
+        reporter: ErrorReporter[_ReqT],
+    ) -> bool:
+        """Handle an exception in the same way as _handle_exception().
+
+        In addition, report the exception, as well as any other exception
+        raised in the process of handling it, to the error reporter.
+        """
+        reporter(req, ex, params, err_handler is not None)
+
+        # NOTE(caselit): Reset body, data and media before calling the handler
+        resp.text = resp.data = resp.media = None
+        if err_handler is None:
+            return False
+
+        # NOTE: The names of the caught exceptions below must differ from ex,
+        #   since Python unbinds the name upon leaving the except clause.
+        try:
+            err_handler(req, resp, ex, params)
