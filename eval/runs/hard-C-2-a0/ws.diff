 _HookImplFunction: TypeAlias = Callable[..., _T | Generator[None, Result[_T], None]]
 
 
+def _kwargdefaults(function: object, kwargnames: tuple[str, ...]) -> dict[str, object]:
+    """Return the default values of the given keyword parameters."""
+    if not kwargnames:
+        return {}
+    try:
+        parameters = inspect.signature(function).parameters  # type: ignore[arg-type]
+    except (TypeError, ValueError):  # pragma: no cover
+        return {}
+    return {
+        name: parameters[name].default for name in kwargnames if name in parameters
+    }
+
+
