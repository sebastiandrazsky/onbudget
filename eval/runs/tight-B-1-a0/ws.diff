+def _is_collection_type(type_: Any, mapping_only: bool = False) -> bool:
+    """Check if a type (or the origin of a parameterized type) is a Sequence, Set, or Mapping subclass.
+
+    `str`, `bytes`, and `bytearray` are sequences, but are not considered collections.
+    """
+    origin = get_origin(type_) or type_
+    if not isinstance(origin, type):
+        return False
+    try:
+        if issubclass(origin, (str, bytes, bytearray)):
+            return False
+        return issubclass(origin, Mapping if mapping_only else (Sequence, AbstractSet, Mapping))
+    except TypeError:
+        return False
+
+
+def _annotation_contains_collection(annotation: Any, mapping_only: bool = False) -> bool:
+    """Check if a type annotation is, or contains, a Sequence, Set, or Mapping type."""
+    annotation = _strip_annotated(annotation)
+    if _is_collection_type(annotation, mapping_only):
+        return True
+    return any(_annotation_contains_collection(type_, mapping_only) for type_ in get_args(annotation))
+
+
 def _strip_annotated(annotation: Any) -> Any:
     if typing_objects.is_annotated(get_origin(annotation)):
         return annotation.__origin__
