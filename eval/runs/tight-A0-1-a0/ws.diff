+def test_handler_reraises_same(asgi, app, client, reports):
+    def reraise(req, resp, ex, params):
+        raise ex
+
+    app.add_route('/gone', _resource(asgi, _raiser(falcon.HTTPGone)))
+    app.add_route('/status', _resource(asgi, _raiser(falcon.HTTPStatus(202))))
+    app.add_route('/custom', _resource(asgi, _raiser(CustomError)))
