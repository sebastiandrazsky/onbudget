+        resp.status = 418
+
+    app.add_route('/items/{item_id:int}', _resource(asgi, _raiser(CustomError)))
+    app.add_error_handler(CustomError, _handler(asgi, handle))
+
+    assert client.simulate_get('/items/7').status_code == 418
+    ((req, ex, params, handled),) = reports
