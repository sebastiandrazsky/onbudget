@@ -639,6 +638,66 @@
     pm.hook.myhook(config=config, args=args)
     # New caller; hookimpls will get new_arg="get this".
     pm.hook.myhook(config=config, args=args, new_arg="get this")
+
+
+.. _hookimpl_arg_default:
+
+Hookimpl argument defaults
+^^^^^^^^^^^^^^^^^^^^^^^^^^
+A *hookimpl* can also declare a default value for an argument. Unlike an
+argument without a default, such an argument does not have to be defined in the
+*hookspec*, which allows a plugin to support an older version of the host
+program, whose *hookspec* does not have the argument yet:
+
+.. code-block:: python
+
+    # Old hookspec, before new_arg was added.
+    @hookspec
+    def myhook(config, args):
+        pass
+
+
+    @hookimpl
+    def myhook(args, new_arg="impl default"):
+        print(new_arg)
+
+
+    # Neither the call nor the hookspec provides new_arg;
+    # the hookimpl will get new_arg="impl default".
+    pm.hook.myhook(config=config, args=args)
+
+The *hookimpl*'s own default is only a fallback. The value an argument receives
+is, in order of precedence:
+
+1. the value passed by the hook call,
+2. the default value declared by the *hookspec*
+   (see :ref:`hookspec_arg_default`),
+3. the default value declared by the *hookimpl*.
+
+.. code-block:: python
+
+    @hookspec
+    def myhook(config, args, new_arg="spec default"):
+        pass
+
+
+    @hookimpl
+    def myhook(args, new_arg="impl default"):
+        print(new_arg)
+
