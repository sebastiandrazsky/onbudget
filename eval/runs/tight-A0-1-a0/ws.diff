+import falcon.testing as testing
+
+
+class Reports(list):
+    def __call__(self, req, ex, params, handled):
+        self.append((req, ex, params, handled))
+
+    @property
+    def summary(self):
+        return [(type(ex), handled) for _, ex, _, handled in self]
+
+
+class CustomError(Exception):
+    pass
+
+
+def _resource(asgi, body):
+    if asgi:
+
+        class Resource:
+            async def on_get(self, req, resp, **params):
+                body(req, resp, **params)
+
+    else:
+
+        class Resource:
+            def on_get(self, req, resp, **params):
+                body(req, resp, **params)
+
+    return Resource()
+
+
+def _handler(asgi, body):
+    if asgi:
+
+        async def handler(req, resp, ex, params):
+            body(req, resp, ex, params)
+
+    else:
+
+        def handler(req, resp, ex, params):
+            body(req, resp, ex, params)
+
+    return handler
+
+
+def _raiser(ex_or_type):
+    def body(*args, **kwargs):
+        raise ex_or_type
+
+    return body
+
+
+@pytest.fixture
+def reports():
+    return Reports()
+
+
+@pytest.fixture
+def app(asgi, util, reports):
+    app = util.create_app(asgi)
+    app.set_error_reporter(reports)
+    return app
+
+
+@pytest.fixture
+def client(app):
+    return testing.TestClient(app)
+
+
+def test_no_reporter(asgi, util):
+    app = util.create_app(asgi)
+    app.add_route('/', _resource(asgi, _raiser(falcon.HTTPGone)))
+    assert testing.simulate_get(app, '/').status_code == 410
+
+
+def test_route_not_found(client, reports):
+    assert client.simulate_get('/nope').status_code == 404
+    assert reports.summary == [(falcon.HTTPRouteNotFound, True)]
+
+
+def test_replace_reporter(app, client, reports):
+    other = Reports()
+    app.set_error_reporter(other)
+    client.simulate_get('/nope')
+    assert not reports
+    assert len(other) == 1
+
+    app.set_error_reporter(None)
+    client.simulate_get('/nope')
+    assert len(other) == 1
+
+
