+_COLLECTION_TYPES: tuple[type[Any], ...] = (Sequence, AbstractSet, Mapping)
+_NON_COLLECTION_TYPES: tuple[type[Any], ...] = (str, bytes, bytearray)
+
+
+def _is_collection_type(type_: Any, collection_types: tuple[type[Any], ...] = _COLLECTION_TYPES) -> bool:
+    """Check if a type is a subclass of any of the collection types.
+
+    `str`, `bytes` and `bytearray` are sequences too, but hold a single value and are never collections.
+    """
+    return _lenient_issubclass(type_, collection_types) and not issubclass(type_, _NON_COLLECTION_TYPES)
+
+
+def _annotation_contains_collection(
+    annotation: Any,
+    collection_types: tuple[type[Any], ...] = _COLLECTION_TYPES,
+    is_strip_annotated: bool = False,
+) -> bool:
+    """Check if a type annotation contains a subclass of any of the collection types.
+
+    Unlike `_annotation_contains_types`, which matches exact types and origins, this also matches
+    subtypes such as `tuple`, `frozenset`, `deque`, `MutableSequence` or `OrderedDict`.
+    """
+    if is_strip_annotated:
+        annotation = _strip_annotated(annotation)
+    if _is_collection_type(get_origin(annotation), collection_types):
+        return True
+    if any(
+        _annotation_contains_collection(type_, collection_types, is_strip_annotated=is_strip_annotated)
+        for type_ in get_args(annotation)
+    ):
+        return True
+    return _is_collection_type(annotation, collection_types)
+
