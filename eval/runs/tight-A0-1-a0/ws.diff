+import pytest
+
+from markdown_it import MarkdownIt
+from markdown_it.common.utils import (
+    MD_TRIM_CHARS,
+    MD_TRIM_RE,
+    mdTrim,
+    normalizeReference,
+)
+
+NOT_MD_WHITESPACE = ["\x1c", "\x1d", "\x1e", "\x1f", "\x85"]
+
+
+def test_trim_chars():
+    assert not set(NOT_MD_WHITESPACE) & set(MD_TRIM_CHARS)
+    assert "\ufeff" not in MD_TRIM_CHARS
+    assert all(ch.isspace() for ch in MD_TRIM_CHARS)
+    assert mdTrim(" \t\n\u00a0\x85 x \x1c\u3000\r") == "\x85 x \x1c"
+    assert MD_TRIM_RE.fullmatch(MD_TRIM_CHARS)
+    assert MD_TRIM_RE.split("a \t b\x85c") == ["a", "b\x85c"]
+
+
+@pytest.mark.parametrize("ch", NOT_MD_WHITESPACE)
+def test_not_stripped(ch):
+    md = MarkdownIt().enable("table")
+    assert md.render(f"x{ch}") == f"<p>x{ch}</p>\n"
+    assert md.render(f" {ch}x \t") == f"<p>{ch}x</p>\n"
+    assert md.render(f"# x{ch} ") == f"<h1>x{ch}</h1>\n"
+    assert md.render(f"x{ch} \n===") == f"<h1>x{ch}</h1>\n"
+    table = md.render(f"| a{ch} | b |\n|---|---|\n| {ch}c | d |")
+    assert f"<th>a{ch}</th>" in table
+    assert f"<td>{ch}c</td>" in table
+
+
+@pytest.mark.parametrize("ch", NOT_MD_WHITESPACE)
+def test_reference_label(ch):
+    md = MarkdownIt()
+    assert normalizeReference(f"a{ch}b") != normalizeReference("a b")
+    assert normalizeReference(" a \t\n b ") == normalizeReference("a b")
+    assert md.render(f"[a b]\n\n[a{ch}b]: http://example.com") == "<p>[a b]</p>\n"
+    assert "<a href" in md.render("[a \t b]\n\n[a b]: http://example.com")
+
+
+@pytest.mark.parametrize("ch", NOT_MD_WHITESPACE)
+def test_fence_info(ch):
+    md = MarkdownIt()
+    assert 'class="language-a%sb"' % ch in md.render(f"```a{ch}b c\nx\n```")
+    assert 'class="language-a"' in md.render("``` a \t b\nx\n```")
