+def _is_collection_type(type_: Any, bases: tuple[type[Any], ...]) -> bool:
+    """Check if a type (or its origin) is a subclass of any of the collection `bases`, excluding string-like types."""
+    origin = get_origin(type_) or type_
+    try:
+        return (
+            isinstance(origin, type) and issubclass(origin, bases) and not issubclass(origin, _CLI_NON_COLLECTION_TYPES)
+        )
+    except TypeError:  # pragma: no cover
+        return False
