+def _annotation_contains_collection(
+    annotation: Any, bases: tuple[type[Any], ...] = _CLI_COLLECTION_TYPES, is_strip_annotated: bool = True
+) -> bool:
+    """Check if a type annotation contains a collection type, i.e. a subclass of any of the collection `bases`.
+
+    `str`, `bytes` and `bytearray` (and their subclasses) are sequences but are not treated as collections.
+    """
+    if is_strip_annotated:
+        annotation = _strip_annotated(annotation)
+    if _is_collection_type(annotation, bases):
+        return True
+    return any(
+        _annotation_contains_collection(type_, bases, is_strip_annotated=is_strip_annotated)
+        for type_ in get_args(annotation)
+    )
