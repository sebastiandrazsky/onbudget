+++ b/markdown-it-py/tests/test_api/test_md_trim.py
@@ -0,0 +1,129 @@
+"""Tests that only the JS ``String.prototype.trim`` whitespace set is trimmed.
+
+Python's ``str.strip()``/``str.split()`` additionally treat
+U+001C, U+001D, U+001E, U+001F and U+0085 as whitespace.
+"""
+
+import pytest
+
+from markdown_it import MarkdownIt
+from markdown_it.common.utils import (
+    MD_TRIM_CHARS,
+    MD_TRIM_RE,
+    mdTrim,
+    normalizeReference,
+)
+from markdown_it.token import Token
+
+NON_MD_SPACE = ["\x1c", "\x1d", "\x1e", "\x1f", "\x85"]
+JS_TRIM = (
+    "\t\n\v\f\r   "
+    + "".join(chr(c) for c in range(0x2000, 0x200B))
+    + " 
\ No newline at end of file
+ 
\ No newline at end of file
+  　"
+)
+
+
+def test_trim_chars():
+    assert set(MD_TRIM_CHARS) == set(JS_TRIM)
+    assert len(MD_TRIM_CHARS) == len(JS_TRIM)
+    assert "﻿" not in MD_TRIM_CHARS
+    # differs from python whitespace only by the five characters
+    py_space = {chr(c) for c in range(0x110000) if chr(c).isspace()}
+    assert py_space - set(MD_TRIM_CHARS) == set(NON_MD_SPACE)
+    assert set(MD_TRIM_CHARS) <= py_space
+
+
