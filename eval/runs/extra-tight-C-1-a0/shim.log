{"ts": 1791505968.0224378, "task": "werkzeug-cond", "argv": ["python", "-W", "error", "-c", "\nimport io, warnings\nfrom werkzeug.utils import send_file\nfrom werkzeug.test import create_environ\nfrom werkzeug import http\nfrom werkzeug.middleware.shared_data import SharedDataMiddleware\np='tests/res/test.txt'\nrv=send_file(p, create_environ(headers={'Range':'bytes=0-1'})); print(rv.status_code, rv.headers['Content-Range'], rv.get_data(), rv.headers['ETag']); rv.close()\nrv=send_file(p, create_environ(), use_x_sendfile=True); print(rv.get_data(), 'X-Sendfile' in rv.headers)\ntry: send_file(p, create_environ(headers={'If-Match':'\"nope\"'}))\nexcept Exception as e: print(type(e).__name__)\ntry: send_file(io.StringIO('x'), create_environ())\nexcept ValueError as e: print('ValueError')\nrv=send_file(p, create_environ(headers={'If-None-Match':'*'}), use_x_sendfile=True); print(rv.status_code, 'X-Sendfile' in rv.headers)\nfor f,a in ((http.is_byte_range_valid,(0,1,2)),(http.is_resource_modified,(create_environ(),)),(lambda: SharedDataMiddleware(None, {}, cache=False),()),(lambda: SharedDataMiddleware(None, {}, fallback_mimetype='a/b'),())):\n    with warnings.catch_warnings(record=True) as w:\n        warnings.simplefilter('always'); f(*a); print(str(w[0].message)[:70])\n"], "cwd": "/Users/user/Documents/.onbudget-eval-work/extra-tight-C-1-a0/ws/werkzeug-cond"}
{"ts": 1791505973.9910378, "task": "werkzeug-cond", "argv": ["python", "-W", "error", "-c", "\nimport io, warnings\nfrom werkzeug.utils import send_file\nfrom werkzeug.test import create_environ\nfrom werkzeug import http\nfrom werkzeug.middleware.shared_data import SharedDataMiddleware\np='tests/res/test.txt'\nrv=send_file(p, create_environ(headers={'Range':'bytes=0-1'})); print(rv.status_code, rv.headers['Content-Range'], b''.join(rv.response), rv.headers['ETag']); rv.close()\nrv=send_file(p, create_environ(), use_x_sendfile=True); print(list(rv.response), 'X-Sendfile' in rv.headers)\ntry: send_file(p, create_environ(headers={'If-Match':'\"nope\"'}))\nexcept Exception as e: print(type(e).__name__)\ntry: send_file(io.StringIO('x'), create_environ())\nexcept ValueError as e: print('ValueError')\nrv=send_file(p, create_environ(headers={'If-None-Match':'*'}), use_x_sendfile=True); print(rv.status_code, 'X-Sendfile' in rv.headers)\nfor f,a in ((http.is_byte_range_valid,(0,1,2)),(http.is_resource_modified,(create_environ(),)),(lambda: SharedDataMiddleware(None, {}, cache=False),()),(lambda: SharedDataMiddleware(None, {}, fallback_mimetype='a/b'),())):\n    with warnings.catch_warnings(record=True) as w:\n        warnings.simplefilter('always'); f(*a); print(str(w[0].message)[:70])\n"], "cwd": "/Users/user/Documents/.onbudget-eval-work/extra-tight-C-1-a0/ws/werkzeug-cond"}
