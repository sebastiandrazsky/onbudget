{"ts": 1791505853.927383, "task": "werkzeug-cond", "argv": ["python", "-W", "error", "-c", "\nfrom werkzeug import Request, Response\nfrom werkzeug.test import EnvironBuilder\ndef req(method='GET', **h): return Request(EnvironBuilder(method=method, headers=h).get_environ())\nr=Response(b'0123456789'); r.apply_range(req(Range='bytes=0-4')); print(r.status_code, r.headers['Content-Range'], r.content_length, r.get_data(), r.accept_ranges)\nr=Response(b'0123456789'); r.apply_range(req(Range='bytes=-50')); print(r.status_code, r.headers['Content-Range'], r.get_data())\nr=Response(b'0123456789'); r.apply_range(req(Range='bytes=5-100')); print(r.status_code, r.headers['Content-Range'], r.get_data())\ntry: Response(b'0123456789').apply_range(req(Range='bytes=10-'))\nexcept Exception as e: print(type(e).__name__)\nr=Response(b'x'); r.etag='a'; r.apply_conditions(req(**{'If-None-Match':'W/\"a\"'})); print(r.status_code)\nr=Response(b'x'); r.etag=('a',True)\nfor h in ({'If-Match':'\"a\"'},{'If-Match':'*'}):\n    try: r.apply_conditions(req(**h)); print('ok')\n    except Exception as e: print(type(e).__name__)\n"], "cwd": "/Users/user/Documents/.onbudget-eval-work/extra-tight-C-1-a0/ws/werkzeug-cond"}
