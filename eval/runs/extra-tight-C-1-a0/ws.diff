+def _is_subtype(type_: Any, types: tuple[Any, ...]) -> bool:
+    """Check if a type (or the origin of a parameterized type) is a subclass of any of the specified types.
+
+    `str`, `bytes` and `bytearray` are sequences but hold a single value, so they never match.
+    """
+    type_ = get_origin(type_) or type_
+    try:
+        return not issubclass(type_, (str, bytes, bytearray)) and issubclass(type_, types)
+    except TypeError:
+        return False
+
+
+def _annotation_contains_subtypes(
+    annotation: type[Any] | None, types: tuple[Any, ...], is_strip_annotated: bool = False
+) -> bool:
+    """Check if a type annotation is, or contains, a subclass of any of the specified types."""
+    if is_strip_annotated:
+        annotation = _strip_annotated(annotation)
+    if _is_subtype(annotation, types):
+        return True
+    return any(_annotation_contains_subtypes(type_, types, is_strip_annotated) for type_ in get_args(annotation))
 
 
