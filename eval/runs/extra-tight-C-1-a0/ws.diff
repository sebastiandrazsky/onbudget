--- a/werkzeug-cond/tests/test_conditional.py
+++ b/werkzeug-cond/tests/test_conditional.py
@@ -0,0 +1,91 @@
+from __future__ import annotations
+
+from datetime import datetime
+
+import pytest
+
+from werkzeug.exceptions import PreconditionFailed
+from werkzeug.exceptions import RequestedRangeNotSatisfiable
+from werkzeug.test import create_environ
+from werkzeug.wrappers import Request
+from werkzeug.wrappers import Response
+
+
+def make_request(method: str = "GET", **headers: str) -> Request:
+    headers = {k.replace("_", "-"): v for k, v in headers.items()}
+    return Request(create_environ(method=method, headers=headers))
+
+
+def test_if_match() -> None:
+    response = Response(b"x")
+    response.etag = "a"
+    response.apply_conditions(make_request(If_Match='"a"'))
+    response.apply_conditions(make_request(If_Match="*"))
+    assert response.status_code == 200
+
+    with pytest.raises(PreconditionFailed):
+        response.apply_conditions(make_request(If_Match='"b"'))
+
+    with pytest.raises(PreconditionFailed):
+        response.apply_conditions(make_request(If_Match="*"), exists=False)
+
+    response.etag = ("a", True)
+
+    with pytest.raises(PreconditionFailed):
+        response.apply_conditions(make_request(If_Match='"a"'))
+
+
+def test_if_none_match() -> None:
+    response = Response(b"x")
+    response.etag = "a"
+    response.last_modified = datetime(2020, 1, 1)
+    # A present If-None-Match takes precedence even when it does not match.
+    response.apply_conditions(
+        make_request(
+            If_None_Match='"b"', If_Modified_Since="Thu, 02 Jan 2020 00:00:00 GMT"
+        )
+    )
+    assert response.status_code == 200
+
+    with pytest.raises(PreconditionFailed):
+        response.apply_conditions(make_request("POST", If_None_Match='W/"a"'))
+
+    response.apply_conditions(make_request(If_None_Match='W/"a"'))
+    assert response.status_code == 304
+
+
+def test_dates() -> None:
+    response = Response(b"x")
+    response.last_modified = datetime(2020, 1, 2)
+
+    with pytest.raises(PreconditionFailed):
+        response.apply_conditions(
+            make_request(If_Unmodified_Since="Wed, 01 Jan 2020 00:00:00 GMT")
+        )
+
+    response.apply_conditions(
+        make_request(If_Modified_Since="Thu, 02 Jan 2020 00:00:00 GMT")
+    )
+    assert response.status_code == 304
+
+
+def test_apply_range() -> None:
+    response = Response(b"0123456789")
+    response.apply_range(make_request(Range="bytes=0-4"))
+    assert response.status_code == 206
+    assert response.accept_ranges == "bytes"
+    assert response.headers["Content-Range"] == "bytes 0-4/10"
+    assert response.content_length == 5
+    assert response.get_data() == b"01234"
+
+    response = Response(b"0123456789")
+    response.apply_range(make_request(Range="bytes=-50"))
+    assert response.get_data() == b"0123456789"
+
+    response = Response(b"0123456789")
+    response.etag = "a"
+    response.apply_range(make_request(Range="bytes=0-4", If_Range='"b"'))
+    assert response.status_code == 200
+
+    with pytest.raises(RequestedRangeNotSatisfiable):
+        Response(b"0123456789").apply_range(make_request(Range="bytes=10-"))
