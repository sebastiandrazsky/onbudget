+_COLLECTION_TYPES: tuple[type[Any], ...] = (Sequence, AbstractSet, Mapping)
+_MAPPING_TYPES: tuple[type[Any], ...] = (Mapping,)
+# Sequence subclasses that are single values rather than collections of values.
+_NON_COLLECTION_TYPES: tuple[type[Any], ...] = (str, bytes, bytearray)
+
+
+def _is_collection_type(type_: Any, types: tuple[type[Any], ...] = _COLLECTION_TYPES) -> bool:
+    """Check if a type (not an annotation) is a collection subclass of any of the specified abstract types."""
+    if not isinstance(type_, type) or typing_objects.is_typeddict(type_):
+        return False
+    return _lenient_issubclass(type_, types) and not _lenient_issubclass(type_, _NON_COLLECTION_TYPES)
+
+
+def _annotation_contains_collection(
+    annotation: Any,
+    types: tuple[type[Any], ...] = _COLLECTION_TYPES,
+) -> bool:
+    """Check if a type annotation contains a collection type, i.e. a subclass of any of the specified abstract types.
+
+    Both parameterized (e.g. `tuple[str, ...]`) and bare (e.g. `tuple`) annotations are matched. `str`, `bytes` and
+    `bytearray` are sequences but are never considered collections.
+    """
+    annotation = _strip_annotated(annotation)
+    if _is_collection_type(get_origin(annotation), types) or _is_collection_type(annotation, types):
+        return True
+    return any(_annotation_contains_collection(type_, types) for type_ in get_args(annotation))
+
+
+def _is_collection_instance(value: Any, types: tuple[type[Any], ...] = _COLLECTION_TYPES) -> bool:
+    """Check if a value is an instance of a collection type."""
+    return _is_collection_type(type(value), types)
+
+
 def _strip_annotated(annotation: Any) -> Any:
     if typing_objects.is_annotated(get_origin(annotation)):
         return annotation.__origin__
