+# Characters removed by JavaScript's `String.prototype.trim` (minus U+FEFF).
+# Unlike `str.strip()`/`str.split()`/`\s` in Python, this does not include
+# U+001C, U+001D, U+001E, U+001F and U+0085.
+MD_TRIM_CHARS = (
+    "\t\n\v\f\r \u00a0\u1680"
+    "\u2000\u2001\u2002\u2003\u2004\u2005\u2006\u2007\u2008\u2009\u200a"
+    "\u2028\u2029\u202f\u205f\u3000"
+)
+MD_TRIM_RE = re.compile("[" + MD_TRIM_CHARS + "]+")
+
+
+def mdTrim(string: str) -> str:
+    """Strip leading/trailing whitespace, like JavaScript's ``String.prototype.trim``."""
+    return string.strip(MD_TRIM_CHARS)
 
 
