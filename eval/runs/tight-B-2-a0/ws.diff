     return False
 
 
+_COLLECTION_KINDS: tuple[type, ...] = (Sequence, AbstractSet, Mapping)
+# These are sequences too, but are always treated as a single value.
+_NON_COLLECTION_TYPES: tuple[type, ...] = (str, bytes, bytearray)
+
+
+def _is_collection_class(type_: Any, kinds: tuple[type, ...] = _COLLECTION_KINDS) -> bool:
+    """Check if a type is a subclass of any of the collection `kinds`, excluding string-like types."""
+    try:
+        return isinstance(type_, type) and not issubclass(type_, _NON_COLLECTION_TYPES) and issubclass(type_, kinds)
+    except TypeError:
+        return False
+
+
+def _annotation_contains_collection(
+    annotation: Any,
+    kinds: tuple[type, ...] = _COLLECTION_KINDS,
+    is_strip_annotated: bool = True,
+) -> bool:
+    """Check if a type annotation contains a `Sequence`, `Set` or `Mapping` type (or a subclass of one).
+
+    Both parameterized (`tuple[str, ...]`) and bare (`tuple`) types are matched. `str`, `bytes` and `bytearray`
+    are not considered collections.
+    """
+    if is_strip_annotated:
+        annotation = _strip_annotated(annotation)
+    if _is_collection_class(get_origin(annotation), kinds) or _is_collection_class(annotation, kinds):
+        return True
+    return any(
+        _annotation_contains_collection(type_, kinds, is_strip_annotated=is_strip_annotated)
+        for type_ in get_args(annotation)
+    )
+
+
 def _strip_annotated(annotation: Any) -> Any:
     if typing_objects.is_annotated(get_origin(annotation)):
         return annotation.__origin__
