+    def from_header(cls, value: str | None) -> te.Self | None:
+        """Parse a single quoted ETag value with an optional weak ``W/``
+        prefix. Returns ``None`` if the value is empty or invalid (not quoted).
+        """
+        if not value:
+            return None
+
+        weak = False
+        start = 0
+
+        if value.startswith(("W/", "w/")):
+            weak = True
+            start = 2
+
