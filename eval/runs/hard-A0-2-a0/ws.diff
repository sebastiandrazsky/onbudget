+def _is_collection_type(type_: Any, types: tuple[type[Any], ...] = _COLLECTION_TYPES) -> bool:
+    """Check if a (non-parameterized) type is a subclass of any of the collection ABCs in `types`.
+
+    `str`, `bytes` and `bytearray` are sequences but are never treated as collections.
+    """
+    try:
+        if not isinstance(type_, type) or issubclass(type_, _NON_COLLECTION_TYPES):
+            return False
+        return issubclass(type_, types)
+    except TypeError:
