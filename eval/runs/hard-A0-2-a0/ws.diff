+_COLLECTION_TYPES: tuple[type[Any], ...] = (Sequence, AbstractSet, Mapping)
+# Sequences that are consumed as a single scalar value rather than as a collection of items.
+_NON_COLLECTION_TYPES: tuple[type[Any], ...] = (str, bytes, bytearray, memoryview, Enum)
+
