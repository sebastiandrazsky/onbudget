+    """Check if the annotation itself (bare or parameterized) is a collection type, ignoring `Annotated`."""
+    annotation = _strip_annotated(_resolve_type_alias(annotation))
+    return _is_collection_type(annotation, types) or _is_collection_type(get_origin(annotation), types)
