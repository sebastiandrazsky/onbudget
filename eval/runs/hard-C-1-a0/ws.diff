--- a/falcon/tests/test_error_reporter.py
+++ b/falcon/tests/test_error_reporter.py
@@ -0,0 +1,202 @@
+import pytest
+
+import falcon
+import falcon.asgi
+import falcon.testing as testing
+
+
+class Resource:
+    def on_get(self, req, resp, **params):
+        raise ZeroDivisionError('boom')
+
+    def on_put(self, req, resp, **params):
+        raise KeyError('unhandled')
+
+    def on_post(self, req, resp, **params):
+        resp.status = 'not a status'
+
+    def on_delete(self, req, resp, **params):
+        raise falcon.HTTPStatus(204)
+
+
+class ResourceAsync:
+    async def on_get(self, req, resp, **params):
+        raise ZeroDivisionError('boom')
+
+    async def on_put(self, req, resp, **params):
+        raise KeyError('unhandled')
+
+    async def on_post(self, req, resp, **params):
+        resp.set_header('X-Bad', 'café€')
+
+    async def on_delete(self, req, resp, **params):
+        raise falcon.HTTPStatus(204)
+
+
+@pytest.fixture
+def reports():
+    return []
+
+
+@pytest.fixture
+def client(asgi, util, reports):
+    app = util.create_app(asgi)
+    app.add_route('/items/{item}', ResourceAsync() if asgi else Resource())
+    app._error_handlers.pop(Exception)
+
+    def reporter(req, ex, params, handled):
+        reports.append((type(ex), dict(params), handled))
+
+    app.set_error_reporter(reporter)
+    return testing.TestClient(app)
+
+
+def _add_handler(client, asgi, exc, func):
+    if asgi:
+
+        async def handler(req, resp, ex, params):
+            func(ex)
+
+    else:
+
+        def handler(req, resp, ex, params):
+            func(ex)
+
+    client.app.add_error_handler(exc, handler)
+
+
+def _raiser(new_ex=None):
+    def func(ex):
+        raise new_ex or ex
+
+    return func
+
+
+def test_not_found_and_status(client, reports):
+    assert client.simulate_get('/nope').status_code == 404
+    assert client.simulate_delete('/items/1').status_code == 204
+    assert reports == [
+        (falcon.HTTPRouteNotFound, {}, True),
+        (falcon.HTTPStatus, {'item': '1'}, True),
+    ]
+
+
+def test_unhandled(client, reports):
+    with pytest.raises(KeyError):
+        client.simulate_put('/items/1')
+    assert reports == [(KeyError, {'item': '1'}, False)]
+
+
+def test_replace_reporter(client, reports):
+    client.app.set_error_reporter(None)
+    assert client.simulate_get('/nope').status_code == 404
+    assert reports == []
+
+
+def test_handler_reraises_same(client, asgi, reports):
+    _add_handler(client, asgi, ZeroDivisionError, _raiser())
+    with pytest.raises(ZeroDivisionError):
+        client.simulate_get('/items/1')
+    assert reports == [(ZeroDivisionError, {'item': '1'}, True)]
+
+
+@pytest.mark.parametrize(
+    'new_ex,status', [(falcon.HTTPStatus(202), 202), (falcon.HTTPGone(), 410)]
+)
+def test_handler_raises_http(client, asgi, reports, new_ex, status):
+    _add_handler(client, asgi, ZeroDivisionError, _raiser(new_ex))
+    assert client.simulate_get('/items/1').status_code == status
+    assert reports == [
+        (ZeroDivisionError, {'item': '1'}, True),
+        (type(new_ex), {'item': '1'}, True),
+    ]
+
+
+def test_handler_reraises_same_http(client, asgi, reports):
+    _add_handler(client, asgi, falcon.HTTPNotFound, _raiser())
+    assert client.simulate_get('/nope').status_code == 404
+    assert reports == [(falcon.HTTPRouteNotFound, {}, True)]
+
+
+def test_handler_raises_other(client, asgi, reports):
+    _add_handler(client, asgi, ZeroDivisionError, _raiser(ValueError('other')))
