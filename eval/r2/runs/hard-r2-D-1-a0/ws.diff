+def _is_collection_type(annotation: Any, is_mapping_only: bool = False) -> bool:
+    """Check if a type (bare or parameterized) is a Sequence, Set or Mapping subtype.
+
+    `str`, `bytes` and `bytearray` are sequences but are not treated as collections.
+    """
+    origin = get_origin(annotation) or annotation
+    if not isinstance(origin, type):
+        return False
+    if issubclass(origin, (str, bytes, bytearray)):
+        return False
+    bases: tuple[type, ...] = (Mapping,) if is_mapping_only else (Sequence, AbstractSet, Mapping)
+    return issubclass(origin, bases)
+
+
+def _annotation_contains_collection(annotation: Any, is_mapping_only: bool = False) -> bool:
+    """Check if a type annotation is, or contains, a Sequence, Set or Mapping subtype."""
+    annotation = _strip_annotated(annotation)
+    if _is_collection_type(annotation, is_mapping_only):
