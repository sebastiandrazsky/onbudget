{"ts": 1792521525.0031848, "task": "boltons", "argv": ["python", "-c", "\nfrom boltons.tableutils import Table\nprint(repr(Table([[]]).to_text())); print(Table([[],[1]]).to_text()); t=Table([[None,'b'],[1,2]]);print(t.to_text())\nt=Table([[1,2]],headers=['a']);print(t.to_text())\nfrom boltons.timeutils import isoparse,daterange\nfrom datetime import datetime,date\nd=datetime(2020,1,1,1,2,3,51000); print(isoparse(d.isoformat('milliseconds')), isoparse('2020-01-01T00:00:00.1234567'))\nfor s in [0,(0,0,0),(0,1,-31)]:\n  try: next(daterange(date(2020,1,1),None,s)); print('bad')\n  except ValueError: pass\nprint(list(daterange(date(2020,1,1),date(2020,1,5),-1)), len(list(daterange(date(2020,1,5),date(2020,1,1),-1))))\nfrom boltons.strutils import multi_replace; print(multi_replace('abc',{}))\nfrom boltons.iterutils import xfrange,frange; print(list(xfrange(5,0,step=-1.25)), list(xfrange(1,5,step=-1)), list(xfrange(5,0)), len(list(xfrange(10.0,step=0.1))))\n"], "cwd": "/Users/user/Documents/.onbudget-eval-work/hard-r2-C-1-a0/ws/boltons"}
