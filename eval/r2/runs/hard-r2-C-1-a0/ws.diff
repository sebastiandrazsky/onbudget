+def _is_collection_type(type_: Any, bases: tuple[type, ...] = (Sequence, AbstractSet, Mapping)) -> bool:
+    """Check if a type (bare or parameterized) is a subclass of one of the collection ``bases``.
+
+    ``str``, ``bytes`` and ``bytearray`` are sequences but are not treated as collections.
+    """
+    origin = get_origin(type_) or type_
+    if not isinstance(origin, type) or issubclass(origin, (str, bytes, bytearray)):
+        return False
+    try:
+        return issubclass(origin, bases)
+    except TypeError:
+        return False
+
+
+def _annotation_contains_collection(
+    annotation: type[Any] | None, bases: tuple[type, ...] = (Sequence, AbstractSet, Mapping)
+) -> bool:
+    """Check if a type annotation is, or contains, a collection type (see ``_is_collection_type``)."""
+    annotation = _strip_annotated(annotation)
+    if _is_collection_type(annotation, bases):
+        return True
+    return any(_annotation_contains_collection(type_, bases) for type_ in get_args(annotation))
 
 
