--- a/falcon/tests/test_error_reporter.py
+++ b/falcon/tests/test_error_reporter.py
@@ -0,0 +1,202 @@
+import pytest
+
+import falcon
+import falcon.asgi
+import falcon.testing as testing
+
+
+class Reporter:
+    def __init__(self):
+        self.calls = []
+
+    def __call__(self, req, ex, params, handled):
+        self.calls.append((type(ex), params, handled))
+
+
+def _make_app(asgi, util):
+    app = util.create_app(asgi)
+    reporter = Reporter()
+    app.set_error_reporter(reporter)
+    return app, reporter
+
+
+def _responder(asgi, func):
+    if asgi:
+
+        async def responder(req, resp, **kwargs):
+            func(req, resp, **kwargs)
+    else:
+
+        def responder(req, resp, **kwargs):
+            func(req, resp, **kwargs)
+
+    return responder
+
+
+def _handler(asgi, func):
+    if asgi:
+
+        async def handler(req, resp, ex, params):
+            func(req, resp, ex, params)
+    else:
+
+        def handler(req, resp, ex, params):
+            func(req, resp, ex, params)
+
+    return handler
+
+
+class Resource:
+    def __init__(self, asgi, func):
+        self.on_get = _responder(asgi, func)
+
+
+def _divide(req, resp, **kwargs):
+    1 / 0
+
+
+def test_route_not_found(asgi, util):
+    app, reporter = _make_app(asgi, util)
+    resp = testing.simulate_get(app, '/nope')
+    assert resp.status_code == 404
+    assert reporter.calls == [(falcon.HTTPRouteNotFound, {}, True)]
+
+
+def test_replaces_reporter(asgi, util):
+    app, first = _make_app(asgi, util)
+    second = Reporter()
+    app.set_error_reporter(second)
+    testing.simulate_get(app, '/nope')
+    assert first.calls == []
+    assert len(second.calls) == 1
+
+
+def test_params_and_default_handler(asgi, util):
+    app, reporter = _make_app(asgi, util)
+    app.add_route('/items/{item_id}', Resource(asgi, _divide))
+    resp = testing.simulate_get(app, '/items/42')
+    assert resp.status_code == 500
+    assert reporter.calls == [(ZeroDivisionError, {'item_id': '42'}, True)]
+
+
+def test_handler_raises_status(asgi, util):
+    app, reporter = _make_app(asgi, util)
+    app.add_route('/', Resource(asgi, _divide))
+
+    def raise_status(req, resp, ex, params):
+        raise falcon.HTTPStatus(falcon.HTTP_204)
+
+    app.add_error_handler(ZeroDivisionError, _handler(asgi, raise_status))
+    resp = testing.simulate_get(app, '/')
+    assert resp.status_code == 204
+    assert reporter.calls == [
+        (ZeroDivisionError, {}, True),
+        (falcon.HTTPStatus, {}, True),
+    ]
+
+
+def test_handler_reraises_same(asgi, util):
+    app, reporter = _make_app(asgi, util)
+
+    def raise_error(req, resp, **kwargs):
+        raise falcon.HTTPForbidden()
+
+    def reraise(req, resp, ex, params):
+        raise ex
+
+    app.add_route('/', Resource(asgi, raise_error))
+    app.add_error_handler(falcon.HTTPForbidden, _handler(asgi, reraise))
+    resp = testing.simulate_get(app, '/')
+    assert resp.status_code == 403
+    assert reporter.calls == [(falcon.HTTPForbidden, {}, True)]
+
+
+def test_handler_raises_other(asgi, util):
+    app, reporter = _make_app(asgi, util)
+    app.add_route('/', Resource(asgi, _divide))
+
+    def raise_other(req, resp, ex, params):
+        raise KeyError('oops')
+
+    app.add_error_handler(ZeroDivisionError, _handler(asgi, raise_other))
+    with pytest.raises(KeyError):
+        testing.simulate_get(app, '/')
+    assert reporter.calls == [(ZeroDivisionError, {}, True), (KeyError, {}, False)]
+
+
+def test_serializer_raises(asgi, util):
+    app, reporter = _make_app(asgi, util)
+
+    def serializer(req, resp, ex):
+        raise ValueError('bad serializer')
+
+    app.set_error_serializer(serializer)
+    with pytest.raises(ValueError):
+        testing.simulate_get(app, '/nope')
+    assert reporter.calls == [
+        (falcon.HTTPRouteNotFound, {}, True),
+        (ValueError, {}, False),
+    ]
+
+
+def test_unhandled(asgi, util):
+    app, reporter = _make_app(asgi, util)
+    app._error_handlers.pop(Exception)
+    app.add_route('/', Resource(asgi, _divide))
+    with pytest.raises(ZeroDivisionError):
+        testing.simulate_get(app, '/')
+    assert reporter.calls == [(ZeroDivisionError, {}, False)]
+
+
+def test_invalid_status(asgi, util):
+    app, reporter = _make_app(asgi, util)
+
+    def bad_status(req, resp, **kwargs):
+        resp.status = 'invalid'
+
+    app.add_route('/', Resource(asgi, bad_status))
+    with pytest.raises(Exception) as exc_info:
+        testing.simulate_get(app, '/')
+    assert reporter.calls == [(type(exc_info.value), {}, False)]
+
+
+def test_invalid_asgi_header():
+    app = falcon.asgi.App()
+    reporter = Reporter()
+    app.set_error_reporter(reporter)
+
+    def bad_header(req, resp, **kwargs):
+        resp.set_header('X-Bad', '\N{SNOWMAN}')
+
+    app.add_route('/', Resource(True, bad_header))
+    with pytest.raises(ValueError):
+        testing.simulate_get(app, '/')
+    assert reporter.calls == [(ValueError, {}, False)]
+
+
+def test_websocket():
+    app = falcon.asgi.App()
+    reporter = Reporter()
+    app.set_error_reporter(reporter)
+
+    class WSResource:
+        async def on_websocket(self, req, ws):
+            await ws.accept()
