+    def set_error_reporter(self, reporter: ErrorReporter[_ReqT] | None) -> None:
+        """Set a callable to observe every exception raised during a request.
+
+        The reporter is called for every exception that is passed to the
+        app's error handling, including instances of :class:`~.HTTPError`
+        and :class:`~.HTTPStatus`, whether it was raised while routing, in
+        middleware, in a responder, or while rendering the response. This
+        can be used, for instance, to log exceptions or to send them to an
+        error tracking service.
+
+        The reporter is called before the matching error handler (if any)
+        is invoked, and it takes the form::
+
+            def reporter(
+                req: Request, ex: Exception, params: dict[str, Any], handled: bool
+            ) -> None:
+                ...
+
+        `handled` is ``True`` when an error handler matches the exception
+        type, and ``False`` when none does, in which case the exception
+        propagates to the application server.
+
+        If an error handler raises an instance of :class:`~.HTTPError` or
+        :class:`~.HTTPStatus`, the new exception is also reported (as
+        handled). If an error handler (or the error serializer) raises any
+        other exception, it is reported with ``handled=False`` and
+        propagates to the application server. An error handler re-raising
+        the very same exception object does not cause a second report.
+        Exceptions raised while starting the response (for instance, due to
+        an invalid status) are also reported with ``handled=False``.
+
+        Only one reporter can be set; calling this method again replaces
+        the previous reporter. Passing ``None`` removes it.
+
+        Note:
+            The reporter is a plain synchronous callable, also in the case
+            of an ASGI app.
+
+        Args:
+            reporter (callable): A function taking the form
+                ``func(req, ex, params, handled)``, where `req` is the
+                request object, `ex` is the exception, `params` is the
+                dict of responder keyword arguments, and `handled` is a
+                ``bool``.
+        """
