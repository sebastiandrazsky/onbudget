.DS_Store
__pycache__/
*.pyc
# Engine-written type declarations (regenerated at every load)
.claude-plugin/types/
# Full raw run directories stay on disk; only the light per-run files are committed (see eval/README.md)
eval/runs/*/ws/
eval/runs/*/transcript/
eval/runs/*/home/
eval/*.nohup
eval/tmp/
# onbudget's own event log (ONBUDGET_LOG=1), written in the plugin's folder: here when the repository is the plugin
log/
